# SMTP config for autonomous email-apply via scripts/send-email.mjs
# Copy this file to `.env` (which is gitignored) and fill in real values.
#
# For Gmail:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password (16 chars): https://myaccount.google.com/apppasswords
#      Pick: app = "Mail", device = "Mac" (or any name). Google shows the password ONCE.
#   3. Paste the 16-char app password into SMTP_PASS below — NOT your regular Google password.
#
# For other providers (Mailgun, SendGrid, AWS SES, etc.) — adjust SMTP_HOST/PORT/SECURE accordingly.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=paste-your-16-char-gmail-app-password-here
SMTP_FROM_NAME=Your Full Name
SMTP_FROM_EMAIL=you@gmail.com

# Optional: BCC every outgoing application to yourself for record-keeping
# SMTP_BCC=you@gmail.com
